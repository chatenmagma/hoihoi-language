clusterA = "just one element is already an ordered"
clusterB = ["I am the first str", "And me the second"]

print("just print my var")
print("clusterA:", clusterA)
print("clusterB:", clusterB)
print()

# Concat
print("concat clusterA and clusterB")
print(clusterA + clusterB)
print()

# substract
print("substract")
print(clusterA - clusterB)
print()

# Catesian
print("Catesian")
print(clusterA * clusterB)
print()

# Let's set values
clusterA = 18
clusterB = [1, 3]

print("just print my var")
print("clusterA:", clusterA)
print("clusterB:", clusterB)
print()

print("divide")
print((clusterA * clusterA) / clusterB)
print()
