# Welcome to use functions are totally in contradiction by the philosophy of language

import math # Let's import the devil module with illegal functions (by philosophy)

# Let's do an addition

a = 3
b = 2

print(math.addition(a, b)) # You can see 5

# With a cluster and scalar

a = [1, 2, 3, 4]
scalar = 4

print(math.addition(a, scalar)) # [5, 6, 7, 8]

# We can see the size of cluster

vectorA = "Just one element"
